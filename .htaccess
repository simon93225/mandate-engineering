# BEGIN Security Headers
<IfModule mod_headers.c>
    # Prevent MIME-sniffing
    Header set X-Content-Type-Options "nosniff"
    # Clickjacking protection
    Header set X-Frame-Options "SAMEORIGIN"
    # Reduce referrer data leakage
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    # Block XSS auditor (legacy, harmless to keep)
    Header set X-XSS-Protection "1; mode=block"
    # Disable unnecessary browser features
    Header set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
    # Note: HSTS (Strict-Transport-Security) is intentionally omitted until
    # the site is served over HTTPS. Adding it on plain HTTP is ignored and
    # only meaningful after SSL is enabled.
</IfModule>

# Disable server-side script execution in the uploads directory
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^wp-content/uploads/.*\.(php|phtml|phar)$ - [F,L]
</IfModule>
# END Security Headers

# BEGIN WordPress
# The directives (lines) between "BEGIN WordPress" and "END WordPress" are
# dynamically generated, and should only be modified via WordPress filters.
# Any changes to the directives between these markers will be overwritten.
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
RewriteBase /
RewriteRule ^index\.php$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.php [L]
</IfModule>

# END WordPress
