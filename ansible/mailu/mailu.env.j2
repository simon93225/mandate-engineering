# ============================================================================
# Mailu configuration (rendered by Ansible from provision-mailu.yml)
# ============================================================================

# --- General --------------------------------------------------------------
SECRET_KEY={{ mailu_secret_key }}
TZ={{ mailu_tz }}
HOSTNAMES={{ mailu_hostname }}
POSTMASTER=postmaster@{{ mailu_domain }}
DOMAIN={{ mailu_domain }}
ADMIN=admin@{{ mailu_domain }}
SITENAME={{ mailu_sitename }}
WEBSITE=https://{{ mailu_hostname }}

# --- Features -------------------------------------------------------------
# AV scanning (clamav), fetch external POP/IMAP, calendar/contacts (webdav)
ANTIVIRUS={{ mailu_antivirus }}
FETCHMAIL={{ mailu_fetchmail }}
WEBDAV={{ mailu_webdav }}

# --- Ports ----------------------------------------------------------------
BIND_ADDRESS4=0.0.0.0

# --- TLS ------------------------------------------------------------------
# hardened = strong ciphers | intermediate = broader compatibility
TLS=hardened
# letsencrypt = auto certs (needs port 80 + 443 reachable + DNS A records)
TLS_FLAVOR=letsencrypt

# --- Database -------------------------------------------------------------
DB_FLAVOR=postgresql
DB_HOST=postgresql
DB_USER={{ mailu_db_user }}
DB_NAME={{ mailu_db_name }}
DB_PASS={{ mailu_db_pass }}

# --- Network --------------------------------------------------------------
SUBNET={{ mailu_subnet }}

# --- Version --------------------------------------------------------------
MAILU_VERSION=1.19
DOCKER_ORG=mailu
DOCKER_PREFIX=mailu